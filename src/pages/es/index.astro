---
import EvidenceExplorer from "../../components/EvidenceExplorer";
import profile from "../../../profiles/daniel.json";
import type { ResumilioProfile } from "../../profile";
import { absoluteUrl, withBase } from "../../site";
import { buildProfileJsonLd } from "../../structured-data";
import "../../styles/global.css";

const publicProfile = profile as ResumilioProfile;
const canonical = absoluteUrl("/es/");
const alternate = absoluteUrl("/");
const socialImage = absoluteUrl("/media/resumilio-v0.8.0-social.png");
const jsonLd = buildProfileJsonLd(publicProfile, "es");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={publicProfile.profile.summary.es} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={canonical} />
    <link rel="alternate" hreflang="en" href={alternate} />
    <link rel="alternate" hreflang="x-default" href={alternate} />
    <link rel="preload" as="image" type="image/webp" href={withBase("/media/avatar/daniel-idle-poster.webp")} fetchpriority="high" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Daniel Rosales" />
    <meta property="og:title" content={`Daniel Rosales — ${publicProfile.profile.headline.es}`} />
    <meta property="og:description" content={publicProfile.profile.summary.es} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:title" content={`Daniel Rosales — ${publicProfile.profile.headline.es}`} />
    <meta name="twitter:description" content={publicProfile.profile.summary.es} />
    <title>Daniel Rosales — {publicProfile.profile.headline.es}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <EvidenceExplorer profile={publicProfile} initialLocale="es" client:load />
  </body>
</html>
