{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resumilio-daniel-profile",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "routes": [
    { "pattern": "danienremoto.com/dani", "zone_name": "danienremoto.com" },
    { "pattern": "danienremoto.com/dani/*", "zone_name": "danienremoto.com" },
    { "pattern": "www.danienremoto.com/dani", "zone_name": "danienremoto.com" },
    { "pattern": "www.danienremoto.com/dani/*", "zone_name": "danienremoto.com" }
  ],
  "assets": {
    "directory": "./personal-dist"
  }
}
