{
  "name": "resumilio",
  "version": "0.8.0",
  "type": "module",
  "description": "Person-first, evidence-backed living resume engine.",
  "license": "MIT",
  "bin": {
    "resumilio": "dist/cli.js",
    "resumilio-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist",
    "schemas",
    "profiles/starter.json",
    "README.md",
    "LICENSE",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:package && npm run build:site",
    "build:package": "node scripts/clean-package-build.mjs && tsc -p tsconfig.build.json",
    "build:site": "astro build",
    "build:personal": "node scripts/build-personal-site.mjs",
    "typecheck": "tsc --noEmit && astro check",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-server.ts",
    "validate": "tsx scripts/validate-profile.ts profiles/daniel.json",
    "test": "tsx --test tests/**/*.test.ts",
    "scan:public": "tsx scripts/scan-public.ts",
    "scan:history": "tsx scripts/scan-public-history.ts",
    "verify:static": "tsx scripts/verify-static-experience.ts",
    "verify:machine": "tsx scripts/verify-machine-experience.ts",
    "verify:quality-contract": "tsx scripts/verify-quality-contract.ts",
    "verify:lighthouse": "tsx scripts/verify-lighthouse.ts",
    "verify:browser-quality": "tsx scripts/verify-browser-quality.ts",
    "verify:release-build": "tsx scripts/verify-release-build.ts",
    "verify:deployment": "tsx scripts/verify-deployment.ts",
    "release:pack": "npm run build:package && tsx scripts/build-release-assets.ts",
    "release:card": "tsx scripts/render-launch-card.ts",
    "dev:cloudflare": "wrangler dev --local",
    "deploy:preview": "npm run build:personal && wrangler versions upload",
    "deploy:public": "npm run build:personal && wrangler deploy",
    "verify:personal-build": "node scripts/verify-personal-build.mjs",
    "phase1": "npm run typecheck && npm run validate && npm test && npm run scan:public",
    "phase2": "npm run build && npm run typecheck && npm run validate && npm test && npm run scan:public && npm pack --dry-run",
    "phase3": "npm run build && npm run typecheck && npm run validate && npm test && npm run verify:static && npm run scan:public",
    "phase4": "npm run build && npm run typecheck && npm run validate && npm test && npm run verify:static && npm run verify:machine && npm run scan:public",
    "phase5": "npm run phase4 && npm run verify:quality-contract && npm run verify:lighthouse",
    "phase6": "npm run phase5 && npm run verify:release-build && npm run scan:history"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danox46/resumilio-daniel-profile.git"
  },
  "bugs": {
    "url": "https://github.com/danox46/resumilio-daniel-profile/issues"
  },
  "homepage": "https://danienremoto.com/dani/",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "resume",
    "portfolio",
    "evidence",
    "mcp",
    "bilingual",
    "living-resume",
    "open-source",
    "typescript"
  ],
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.17.1",
    "astro": "^7.3.2",
    "chrome-launcher": "1.2.1",
    "cookie": "^2.0.1",
    "lighthouse": "13.4.1",
    "playwright-core": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "4.131.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.4"
  }
}
